{% from "govuk/components/tabs/macro.njk" import govukTabs %}

{# Hidden until application.js reveals it, so the code still reads with no JavaScript. #}
{% macro copyCode(targetId) %}<p class="app-code-examples__actions"><button type="button" class="govuk-link app-code-examples__copy" data-copy-target="{{ targetId }}" data-testid="copy-code-button" hidden>Copy code</button></p>{% endmacro %}

{% set requestBody = params.requestBody or { messages: [{ role: "user", content: "Hello" }] } %}
{% set requestBodyJson = requestBody | dump %}

{% set curlHtml %}{{ copyCode("code-examples-curl-code") }}<pre class="govuk-body app-code-examples__pre" id="code-examples-curl-code" data-testid="code-examples-curl"><code>curl {{ params.endpoint }} \
  -H "Ocp-Apim-Subscription-Key: {{ params.secretPlaceholder }}" \
  -H "Content-Type: application/json" \
  -d '{{ requestBodyJson }}'</code></pre>{% endset %}

{% set pythonHtml %}{{ copyCode("code-examples-python-code") }}<pre class="govuk-body app-code-examples__pre" id="code-examples-python-code" data-testid="code-examples-python"><code>import requests

response = requests.post(
    "{{ params.endpoint }}",
    headers={"Ocp-Apim-Subscription-Key": "{{ params.secretPlaceholder }}"},
    json={{ requestBodyJson }},
)</code></pre>{% endset %}

{% set javascriptHtml %}{{ copyCode("code-examples-javascript-code") }}<pre class="govuk-body app-code-examples__pre" id="code-examples-javascript-code" data-testid="code-examples-javascript"><code>await fetch("{{ params.endpoint }}", {
  method: "POST",
  headers: {
    "Ocp-Apim-Subscription-Key": "{{ params.secretPlaceholder }}",
    "Content-Type": "application/json"
  },
  body: JSON.stringify({{ requestBodyJson }})
})</code></pre>{% endset %}

<div class="app-code-examples" data-testid="code-examples">
  {{ govukTabs({
    idPrefix: "code-examples",
    items: [
      { label: "curl", id: "code-examples-curl", panel: { html: curlHtml } },
      { label: "Python", id: "code-examples-python", panel: { html: pythonHtml } },
      { label: "JavaScript", id: "code-examples-javascript", panel: { html: javascriptHtml } }
    ]
  }) }}
</div>
