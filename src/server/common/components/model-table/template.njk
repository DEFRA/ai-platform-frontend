<table class="govuk-table app-model-table" data-testid="model-table">
  <caption class="govuk-table__caption govuk-table__caption--m govuk-visually-hidden">Models you can use</caption>
  <thead class="govuk-table__head">
    <tr class="govuk-table__row">
      <th scope="col" class="govuk-table__header">Model</th>
      <th scope="col" class="govuk-table__header">Good for</th>
      <th scope="col" class="govuk-table__header">Try on your own</th>
      <th scope="col" class="govuk-table__header">Add to a team</th>
    </tr>
  </thead>
  <tbody class="govuk-table__body">
    {% for model in params.models %}
      <tr class="govuk-table__row" data-testid="model-table-row">
        <td class="govuk-table__cell">
          <a class="govuk-link" href="/models/{{ model.slug }}" data-testid="model-table-link">{{ model.displayName }}</a>
        </td>
        <td class="govuk-table__cell" data-testid="model-table-good-for">{{ model.goodFor }}</td>
        <td class="govuk-table__cell" data-testid="model-table-try">
          {% if model.canTry %}
            <a class="govuk-link" href="{{ model.tryUrl }}">Try it<span class="govuk-visually-hidden"> {{ model.displayName }} on your own</span></a>
          {% else %}
            <span class="app-model-table__unavailable">Not available</span>
          {% endif %}
        </td>
        <td class="govuk-table__cell" data-testid="model-table-team">
          {% if model.canAddToTeam %}
            <a class="govuk-link govuk-!-font-weight-bold" href="{{ model.addToTeamUrl }}">Add to a team<span class="govuk-visually-hidden">: {{ model.displayName }}</span></a>
            <div class="govuk-hint govuk-!-margin-bottom-0">{{ model.teamAvailability }}</div>
          {% else %}
            <span class="app-model-table__unavailable">{{ model.teamAvailability }}</span>
          {% endif %}
        </td>
      </tr>
    {% endfor %}
  </tbody>
</table>

{% if params.models.length == 0 %}
  <p class="govuk-body" data-testid="model-table-empty">No models match this choice.</p>
{% endif %}
