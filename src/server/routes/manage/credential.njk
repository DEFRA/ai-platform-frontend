{% extends 'layouts/page.njk' %}

{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block content %}
  {{ appHeading({
    text: heading
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {{ govukTag({
        text: credential.status,
        classes: "govuk-tag--green govuk-!-margin-bottom-4" if credential.status == "active" else ("govuk-tag--red govuk-!-margin-bottom-4" if credential.status == "revoked" else "govuk-!-margin-bottom-4")
      }) }}

      {{ govukSummaryList({
        rows: [
          {
            key: { text: "Provider" },
            value: { text: model.provider }
          },
          {
            key: { text: "Model" },
            value: { text: model.displayName }
          },
          {
            key: { text: "Tier" },
            value: { text: "Team (dedicated deployment)" if credential.teamId else "Research (free trial)" }
          },
          {
            key: { text: "Key" },
            value: { text: "…" + credential.keyHint }
          },
          {
            key: { text: "Endpoint" },
            value: { text: model.endpoint }
          },
          {
            key: { text: "Deployment name" },
            value: { text: model.deploymentName }
          },
          {
            key: { text: "API version" },
            value: { text: model.apiVersion }
          },
          {
            key: { text: "Expires" },
            value: { text: credential.expiresAt }
          }
        ]
      }) }}

      {% if not credential.teamId and credential.status != "revoked" %}
        <div class="app-button-group">
          {% if credential.renewalsRemaining > 0 %}
            <form method="post" action="/manage/credentials/{{ credential._id }}/renew" novalidate class="app-button-group__form">
              <input type="hidden" name="crumb" value="{{ crumb }}">
              {{ govukButton({ text: "Renew" }) }}
            </form>
          {% endif %}

          {{ govukButton({
            text: "Revoke this credential",
            href: "/manage/credentials/" + credential._id + "/revoke",
            classes: "govuk-button--warning"
          }) }}
        </div>
      {% endif %}

      <p class="govuk-body">
        <a class="govuk-link" href="/manage">Back to Manage AI access</a>
      </p>
    </div>
  </div>
{% endblock %}
