{% extends 'layouts/page.njk' %}

{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block content %}
  {{ appHeading({
    text: heading
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {{ govukTag({
        text: credential.status,
        classes: "govuk-!-margin-bottom-4" if credential.status != "active" else "govuk-tag--green govuk-!-margin-bottom-4"
      }) }}

      {{ govukSummaryList({
        rows: [
          {
            key: { text: "Provider" },
            value: { text: model.provider }
          },
          {
            key: { text: "Model" },
            value: { text: model.displayName }
          },
          {
            key: { text: "Tier" },
            value: { text: "Team (dedicated deployment)" if credential.teamId else "Research (free trial)" }
          },
          {
            key: { text: "Key" },
            value: { text: "…" + credential.keyHint }
          },
          {
            key: { text: "Endpoint" },
            value: { text: model.endpoint }
          },
          {
            key: { text: "Deployment name" },
            value: { text: model.deploymentName }
          },
          {
            key: { text: "API version" },
            value: { text: model.apiVersion }
          },
          {
            key: { text: "Expires" },
            value: { text: credential.expiresAt }
          }
        ]
      }) }}

      {% if not credential.teamId and credential.status != "revoked" %}
        {% if credential.renewalsRemaining > 0 %}
          <form method="post" action="/manage/credentials/{{ credential._id }}/renew" novalidate>
            <input type="hidden" name="crumb" value="{{ crumb }}">
            {{ govukButton({ text: "Renew", classes: "govuk-button--secondary" }) }}
          </form>
        {% endif %}

        <p class="govuk-body">
          <a class="govuk-link" href="/manage/credentials/{{ credential._id }}/revoke">Revoke this credential</a>
        </p>
      {% endif %}

      <p class="govuk-body">
        <a class="govuk-link" href="/manage">Back to Manage AI access</a>
      </p>
    </div>
  </div>
{% endblock %}
