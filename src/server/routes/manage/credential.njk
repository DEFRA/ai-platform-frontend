{% extends 'layouts/page.njk' %}

{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block content %}
  {{ appHeading({
    text: heading
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {{ govukTag({
        text: credential.status,
        classes: "govuk-tag--green govuk-!-margin-bottom-4" if credential.status == "active" else ("govuk-tag--red govuk-!-margin-bottom-4" if credential.status == "revoked" else "govuk-!-margin-bottom-4")
      }) }}

      {% if credential.credentialType == "oauth" %}
        {{ govukSummaryList({
          rows: [
            {
              key: { text: "Tier" },
              value: { text: "Team (dedicated deployment)" if credential.teamId else "Research (free trial)" }
            },
            {
              key: { text: "Credential type" },
              value: { text: "Client secret (OAuth)" }
            },
            {
              key: { text: "Client secret" },
              value: { text: "…" + credential.keyHint if credential.keyHint else "Not shown again after issue" }
            },
            {
              key: { text: "Expires" },
              value: { text: credential.expiresAt }
            }
          ]
        }) }}
      {% elif credential.credentialType %}
        {{ govukSummaryList({
          rows: [
            {
              key: { text: "Tier" },
              value: { text: "Team (dedicated deployment)" if credential.teamId else "Research (free trial)" }
            },
            {
              key: { text: "Credential type" },
              value: { text: "Subscription key" }
            },
            {
              key: { text: "Key" },
              value: { text: "…" + credential.keyHint }
            },
            {
              key: { text: "Expires" },
              value: { text: credential.expiresAt }
            }
          ]
        }) }}
      {% else %}
        {{ govukSummaryList({
          rows: [
            {
              key: { text: "Tier" },
              value: { text: "Team (dedicated deployment)" if credential.teamId else "Research (free trial)" }
            },
            {
              key: { text: "Key" },
              value: { text: "…" + credential.keyHint }
            },
            {
              key: { text: "Expires" },
              value: { text: credential.expiresAt }
            }
          ]
        }) }}
      {% endif %}

      <h2 class="govuk-heading-m">Models this credential can use</h2>

      <table class="govuk-table app-credentials-table">
        <thead class="govuk-table__head">
          <tr class="govuk-table__row">
            <th class="govuk-table__header" scope="col">Provider</th>
            <th class="govuk-table__header" scope="col">Model</th>
            <th class="govuk-table__header" scope="col">Endpoint</th>
            <th class="govuk-table__header" scope="col">Deployment name</th>
            <th class="govuk-table__header" scope="col">API version</th>
          </tr>
        </thead>
        <tbody class="govuk-table__body">
          {% for model in models %}
            <tr class="govuk-table__row">
              <td class="govuk-table__cell">{{ model.provider }}</td>
              <td class="govuk-table__cell">{{ model.displayName }}</td>
              <td class="govuk-table__cell">{{ model.endpoint }}</td>
              <td class="govuk-table__cell">{{ model.deploymentName }}</td>
              <td class="govuk-table__cell">{{ model.apiVersion }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>


      {% if not credential.teamId and credential.status != "revoked" %}
        <div class="app-button-group">
          {% if credential.renewalsRemaining > 0 %}
            <form method="post" action="/manage/credentials/{{ credential._id }}/renew" novalidate class="app-button-group__form">
              <input type="hidden" name="crumb" value="{{ crumb }}">
              {{ govukButton({ text: "Renew" }) }}
            </form>
          {% endif %}

          {{ govukButton({
            text: "Revoke this credential",
            href: "/manage/credentials/" + credential._id + "/revoke",
            classes: "govuk-button--warning"
          }) }}
        </div>
      {% elif isAdmin and credential.status != "revoked" %}
        <div class="app-button-group">
          {{ govukButton({
            text: "Rotate this credential",
            href: "/manage/credentials/" + credential._id + "/rotate"
          }) }}

          {{ govukButton({
            text: "Revoke this credential",
            href: "/manage/credentials/" + credential._id + "/revoke",
            classes: "govuk-button--warning"
          }) }}
        </div>
      {% endif %}

      <p class="govuk-body">
        <a class="govuk-link" href="/manage">Back to Manage AI access</a>
      </p>
    </div>
  </div>
{% endblock %}
