{% extends 'layouts/page.njk' %}

{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/tabs/macro.njk" import govukTabs %}
{% from "credential-actions/macro.njk" import appCredentialActions %}

{% block head %}
  {{ super() }}
  {% if refreshSeconds %}
    <meta http-equiv="refresh" content="{{ refreshSeconds }}">
  {% endif %}
{% endblock %}

{% block content %}
  {{ appHeading({
    text: heading
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      {% if notificationBanner %}
        {{ govukNotificationBanner(notificationBanner) }}
      {% endif %}

      <h2 class="govuk-heading-m">Your credentials</h2>

      {% if credentials.length == 0 %}
        <p class="govuk-body">You do not have any credentials yet.</p>
        <p class="govuk-body">
          <a class="govuk-link" href="/connect">Connect to a model</a>
        </p>
      {% else %}
        <table class="govuk-table app-credentials-table">
          <thead class="govuk-table__head">
            <tr class="govuk-table__row">
              <th class="govuk-table__header" scope="col">Model</th>
              <th class="govuk-table__header" scope="col">Status</th>
              <th class="govuk-table__header" scope="col">Key</th>
              <th class="govuk-table__header" scope="col">Expires</th>
              <th class="govuk-table__header" scope="col">Actions</th>
            </tr>
          </thead>
          <tbody class="govuk-table__body">
            {% for credential in credentials %}
              <tr class="govuk-table__row">
                <td class="govuk-table__cell">{{ credential.modelDisplayName }}</td>
                <td class="govuk-table__cell">
                  {{ govukTag({
                    text: credential.status,
                    classes: credential.tagClass
                  }) }}
                </td>
                <td class="govuk-table__cell">…{{ credential.keyHint }}</td>
                <td class="govuk-table__cell">{{ credential.expiresAt }}</td>
                <td class="govuk-table__cell">
                  {{ appCredentialActions({
                    credential: credential,
                    crumb: crumb,
                    showRenewRevoke: true
                  }) }}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      {% endif %}


      <h2 class="govuk-heading-m">Your teams</h2>

      {% if teams.length == 0 %}
        <p class="govuk-body" data-testid="manage-teams-placeholder">You are not a member of a team yet.</p>
      {% else %}
        {% set teamTabItems = [] %}
        {% for team in teams %}
          {% set teamPanelHtml %}
            {% if team.credentials.length == 0 %}
              <p class="govuk-body">This team does not have any credentials yet.</p>
            {% else %}
              <table class="govuk-table app-credentials-table">
                <thead class="govuk-table__head">
                  <tr class="govuk-table__row">
                    <th class="govuk-table__header" scope="col">Model</th>
                    <th class="govuk-table__header" scope="col">Status</th>
                    <th class="govuk-table__header" scope="col">Key</th>
                    <th class="govuk-table__header" scope="col">Expires</th>
                    <th class="govuk-table__header" scope="col">Actions</th>
                  </tr>
                </thead>
                <tbody class="govuk-table__body">
                  {% for credential in team.credentials %}
                    <tr class="govuk-table__row">
                      <td class="govuk-table__cell">{{ credential.modelDisplayName }}</td>
                      <td class="govuk-table__cell">
                        {{ govukTag({
                          text: credential.status,
                          classes: credential.tagClass
                        }) }}
                      </td>
                      <td class="govuk-table__cell">…{{ credential.keyHint }}</td>
                      <td class="govuk-table__cell">{{ credential.expiresAt }}</td>
                      <td class="govuk-table__cell">
                        {{ appCredentialActions({
                          credential: credential,
                          showRenewRevoke: false
                        }) }}
                      </td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            {% endif %}

            {% if team.deployments.length > 0 %}
              <h3 class="govuk-heading-s">Requests</h3>

              <table class="govuk-table app-credentials-table">
                <thead class="govuk-table__head">
                  <tr class="govuk-table__row">
                    <th class="govuk-table__header" scope="col">Model</th>
                    <th class="govuk-table__header" scope="col">Status</th>
                    <th class="govuk-table__header" scope="col">Actions</th>
                  </tr>
                </thead>
                <tbody class="govuk-table__body">
                  {% for deployment in team.deployments %}
                    <tr class="govuk-table__row">
                      <td class="govuk-table__cell">{{ deployment.modelDisplayName }}</td>
                      <td class="govuk-table__cell">
                        {{ govukTag({
                          text: deployment.statusText,
                          classes: deployment.tagClass
                        }) }}
                      </td>
                      <td class="govuk-table__cell">
                        <div class="app-button-group">
                          {{ govukButton({
                            html: 'Check progress' if deployment.status == "active" else '<span class="app-spinner" aria-hidden="true"></span> Check progress',
                            href: deployment.requestUrl,
                            classes: "app-button--progress",
                            attributes: { "data-testid": "deployment-check-progress" }
                          }) }}
                        </div>
                      </td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            {% endif %}

            <p class="govuk-body">
              <a class="govuk-link" href="/teams/{{ team._id }}">View team</a>
            </p>
          {% endset %}

          {% set teamTabItems = teamTabItems.concat([{
            label: team.name,
            id: "manage-team-" + team._id,
            panel: { html: teamPanelHtml }
          }]) %}
        {% endfor %}

        {{ govukTabs({
          idPrefix: "manage-teams",
          items: teamTabItems
        }) }}
      {% endif %}
    </div>
  </div>
{% endblock %}
