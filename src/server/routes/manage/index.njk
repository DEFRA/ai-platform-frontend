{% extends 'layouts/page.njk' %}

{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "credential-actions/macro.njk" import appCredentialActions %}

{% block content %}
  {% if notificationBanner %}
    {{ govukNotificationBanner(notificationBanner) }}
  {% endif %}

  {{ appHeading({
    text: heading
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <p class="govuk-body-l" data-testid="access-lead">Keys for trying models on your own. A key works for {{ researchDays }} days, and you can renew it up to {{ renewalCap }} times.</p>
    </div>
  </div>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      {% if keyRows.length == 0 %}
        <p class="govuk-body" data-testid="keys-empty">You do not have a key yet.</p>
      {% else %}
        <table class="govuk-table app-credentials-table" data-testid="keys-table">
          <caption class="govuk-table__caption govuk-visually-hidden">Your keys</caption>
          <thead class="govuk-table__head">
            <tr class="govuk-table__row">
              <th class="govuk-table__header" scope="col">Model</th>
              <th class="govuk-table__header" scope="col">Expires</th>
              <th class="govuk-table__header" scope="col"><span class="govuk-visually-hidden">Actions</span></th>
            </tr>
          </thead>
          <tbody class="govuk-table__body">
            {% for row in keyRows %}
              <tr class="govuk-table__row" data-testid="keys-table-row">
                <td class="govuk-table__cell">{{ row.modelDisplayName }}</td>
                <td class="govuk-table__cell">
                  {{ row.expiresText }}
                  {% if row.renewedHint %}
                    <p class="govuk-hint govuk-!-margin-bottom-0" data-testid="key-renewed-hint">{{ row.renewedHint }}</p>
                  {% endif %}
                </td>
                <td class="govuk-table__cell">
                  {% if row.getNewKeyUrl %}
                    <a class="govuk-link" href="{{ row.getNewKeyUrl }}" data-testid="key-get-new">Get a new key<span class="govuk-visually-hidden"> for {{ row.modelDisplayName }}</span></a>
                  {% else %}
                    {{ appCredentialActions({
                      credential: row,
                      crumb: crumb,
                      showRenewRevoke: true
                    }) }}
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      {% endif %}

      <p class="govuk-body">
        <a class="govuk-link" href="/connect/shared/start" data-testid="access-try-another">Try another model on your own</a>
      </p>

      {{ govukInsetText({
        html: 'Your teams’ models and client secrets are on each team’s page. <a class="govuk-link" href="/teams" data-testid="access-go-to-teams">Go to Teams</a>',
        attributes: { "data-testid": "access-teams-inset" }
      }) }}
    </div>
  </div>
{% endblock %}
