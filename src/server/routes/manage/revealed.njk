{% extends 'layouts/page.njk' %}

{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "placeholder-credential-notice/macro.njk" import appPlaceholderCredentialNotice %}

{% block content %}
  {{ appHeading({
    text: heading
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {{ govukWarningText({
        text: "This " + secretName + " is shown once. Copy it now and store it safely.",
        iconFallbackText: "Warning"
      }) }}

      {% if placeholderCredential %}
        {{ appPlaceholderCredentialNotice() }}
      {% endif %}

      <div class="app-copy-field">
        <input class="govuk-input app-copy-field__input" id="credential-key" type="text" value="{{ secret }}" readonly aria-label="Your {{ secretName }}">
        <button type="button" class="govuk-button govuk-button--secondary app-copy-button" data-copy-target="credential-key" data-testid="copy-key-button" hidden>Copy {{ secretName }}</button>
      </div>

      <p class="govuk-body">
        <a class="govuk-link" href="{{ returnHref }}">{{ returnText }}</a>
      </p>
    </div>
  </div>
{% endblock %}
