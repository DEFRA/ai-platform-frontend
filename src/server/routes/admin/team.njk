{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "members-table/macro.njk" import appMembersTable %}
{% from "sub-navigation/macro.njk" import appSubNavigation %}

{% block content %}
  {% include "partials/team-notification.njk" %}

  {{ appHeading({
    text: heading,
    caption: "Team",
    captionAbove: true
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      {{ appSubNavigation({ items: tabs, label: "Admin" }) }}

      {% if warning %}
        {{ govukWarningText({
          text: warning,
          iconFallbackText: "Warning",
          attributes: { "data-testid": "team-disabled-warning" }
        }) }}
      {% endif %}

      {% set statusHtml %}{{ govukTag({ text: status.text, classes: status.classes }) }}{% endset %}
      {% set environmentsHtml %}
        {% if environments.length == 0 %}
          None
        {% else %}
          <ul class="govuk-list" data-testid="team-environments">
            {% for environment in environments %}
              <li>
                {% if environment.href %}<a class="govuk-link" href="{{ environment.href }}">{{ environment.name }}</a>{% else %}{{ environment.name }}{% endif %}: {{ govukTag({ text: environment.status.text, classes: environment.status.classes }) }}
                {% if environment.disabled %}
                  {{ govukTag({ text: "Disabled", classes: "govuk-tag--grey", attributes: { "data-testid": "environment-disabled" } }) }}
                {% endif %}
                {% if environment.removeAfter %}
                  <span class="govuk-hint govuk-!-display-inline">Can be removed from {{ environment.removeAfter | formatDate }}</span>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      {% endset %}

      {{ govukSummaryList({
        attributes: { "data-testid": "team-summary" },
        rows: [
          { key: { text: "Status" }, value: { html: statusHtml } },
          { key: { text: "Service code" }, value: { text: team.serviceCode or "Not set" } },
          { key: { text: "Environments" }, value: { html: environmentsHtml } }
        ]
      }) }}

      {% if canDisable or canEnable %}
        <div class="govuk-button-group" data-testid="team-lifecycle-actions">
          {% if canDisable %}
            {{ govukButton({
              text: "Disable team",
              href: disableUrl,
              classes: "govuk-button--secondary",
              attributes: { "data-testid": "disable-team" }
            }) }}
          {% endif %}
          {% if canEnable %}
            {{ govukButton({
              text: "Enable team",
              href: enableUrl,
              attributes: { "data-testid": "enable-team" }
            }) }}
          {% endif %}
        </div>
      {% endif %}

      <p class="govuk-body">
        <a class="govuk-link" href="{{ auditLogUrl }}" data-testid="view-audit-log">View audit log</a>
      </p>

      <h2 class="govuk-heading-l">Members</h2>

      {{ govukButton({
        text: "Add a member",
        href: addMemberUrl,
        attributes: { "data-testid": "add-member" }
      }) }}

      {{ appMembersTable({
        caption: "Members of " + team.name,
        rows: members,
        actionHeading: "Remove",
        actionTestId: "member-remove"
      }) }}
    </div>
  </div>
{% endblock %}
