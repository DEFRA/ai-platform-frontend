{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "members-table/macro.njk" import appMembersTable %}
{% from "sub-navigation/macro.njk" import appSubNavigation %}

{% block content %}
  {% include "partials/team-notification.njk" %}

  {{ appHeading({
    text: heading,
    caption: "Team",
    captionAbove: true
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      {{ appSubNavigation({ items: tabs, label: "Admin" }) }}

      {% set statusHtml %}{{ govukTag({ text: status.text, classes: status.classes }) }}{% endset %}
      {% set environmentsHtml %}
        {% if environments.length == 0 %}
          None
        {% else %}
          <ul class="govuk-list" data-testid="team-environments">
            {% for environment in environments %}
              <li>
                {{ environment.name }}: {{ govukTag({ text: environment.status.text, classes: environment.status.classes }) }}
                {% if environment.removeAfter %}
                  <span class="govuk-hint govuk-!-display-inline">Can be removed from {{ environment.removeAfter | formatDate }}</span>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      {% endset %}

      {{ govukSummaryList({
        attributes: { "data-testid": "team-summary" },
        rows: [
          { key: { text: "Status" }, value: { html: statusHtml } },
          { key: { text: "Service code" }, value: { text: team.serviceCode or "Not set" } },
          { key: { text: "Environments" }, value: { html: environmentsHtml } }
        ]
      }) }}

      <p class="govuk-body">
        <a class="govuk-link" href="{{ auditLogUrl }}" data-testid="view-audit-log">View audit log</a>
      </p>

      <h2 class="govuk-heading-l">Members</h2>

      {{ govukButton({
        text: "Add a member",
        href: addMemberUrl,
        attributes: { "data-testid": "add-member" }
      }) }}

      {{ appMembersTable({
        caption: "Members of " + team.name,
        rows: members,
        actionHeading: "Remove",
        actionTestId: "member-remove"
      }) }}
    </div>
  </div>
{% endblock %}
