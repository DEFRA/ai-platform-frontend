{% extends 'layouts/page.njk' %}

{% from "govuk/components/panel/macro.njk" import govukPanel %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {# The page's heading is the panel's title, so the page has one h1. #}
      {{ govukPanel({
        titleText: heading,
        text: environmentsText,
        attributes: { "data-testid": "credentials-panel" }
      }) }}

      <p class="govuk-body" data-testid="credentials-effect">{{ effect }}</p>

      <p class="govuk-body">
        <a class="govuk-link" href="{{ deploymentUrl }}" data-testid="credentials-back">Back to the deployment</a>
      </p>
    </div>
  </div>
{% endblock %}
