{% extends 'layouts/page.njk' %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">{{ heading }}</h1>

      {% if doneText %}
        <p class="govuk-body" data-testid="credentials-done">{{ doneText }}</p>
      {% endif %}

      <p class="govuk-body">You can try again. What was already done is not done twice.</p>

      <div class="govuk-button-group">
        <a class="govuk-button" href="{{ retryUrl }}" role="button" draggable="false" data-module="govuk-button" data-testid="credentials-retry">Try again</a>
        <a class="govuk-link" href="{{ deploymentUrl }}" data-testid="credentials-back">Back to the deployment</a>
      </div>
    </div>
  </div>
{% endblock %}
