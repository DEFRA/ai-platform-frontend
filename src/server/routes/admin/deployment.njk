{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "sub-navigation/macro.njk" import appSubNavigation %}

{% block content %}
  {{ appSubNavigation({ items: tabs, label: "Admin" }) }}

  {% include "partials/team-notification.njk" %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errorSummary %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: errorSummary
        }) }}
      {% endif %}
    </div>
  </div>

  {{ appHeading({
    text: heading,
    caption: caption,
    captionAbove: true
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <p class="govuk-body">
        {{ govukTag({ text: status.text, classes: status.classes, attributes: { "data-testid": "deployment-status" } }) }}
      </p>

      {% set credentialHtml %}
        {{ govukTag({ text: credential.text, classes: credential.classes }) }}
        {% if blockedAt %}
          <p class="govuk-body-s govuk-!-margin-top-1 govuk-!-margin-bottom-0">Disabled on {{ blockedAt }}</p>
        {% endif %}
        {% if underBlock %}
          <p class="govuk-body-s govuk-!-margin-top-1 govuk-!-margin-bottom-0" data-testid="credential-under-block">Credential under the block: {{ govukTag({ text: underBlock.text, classes: underBlock.classes }) }}</p>
        {% endif %}
      {% endset %}
      {% set membersHtml %}
        {{ memberText }}
        <a class="govuk-link govuk-!-margin-left-2" href="{{ teamUrl }}" data-testid="view-team">View team</a>
      {% endset %}
      {% set teamStatusHtml %}{{ govukTag({ text: team.statusTag.text, classes: team.statusTag.classes }) }}{% endset %}
      {% set portalHtml %}
        {{ govukTag({ text: "Disabled", classes: "govuk-tag--grey", attributes: { "data-testid": "environment-disabled" } }) }}
        <p class="govuk-body-s govuk-!-margin-top-1 govuk-!-margin-bottom-0">The team can view {{ environmentLabel }} but not change it. Its credentials keep working.</p>
      {% endset %}

      {% set summaryRows = [
        { key: { text: "Credential" }, value: { html: credentialHtml } },
        { key: { text: "Members" }, value: { html: membersHtml } },
        { key: { text: "Team status" }, value: { html: teamStatusHtml } }
      ] %}
      {% if environmentDisabled %}
        {% set ignored = summaryRows.push({ key: { text: "In the portal" }, value: { html: portalHtml } }) %}
      {% endif %}

      {{ govukSummaryList({
        attributes: { "data-testid": "deployment-summary" },
        rows: summaryRows
      }) }}

      {% if buttons.length > 0 %}
        <div class="govuk-button-group" data-testid="credential-actions">
          {% for button in buttons %}
            {{ govukButton({
              text: button.text,
              href: button.href,
              classes: button.classes,
              attributes: { "data-testid": button.action + "-credentials" }
            }) }}
          {% endfor %}
        </div>
      {% endif %}

      <p class="govuk-body">
        <a class="govuk-link" href="{{ activityUrl }}" data-testid="view-activity">View activity</a>
      </p>

      {% if clientSecrets %}
        <h2 class="govuk-heading-l" id="client-secrets" tabindex="-1">Client secrets</h2>
        <p class="govuk-body" data-testid="client-secrets-count">{{ clientSecrets.countText }}</p>
        <div class="app-table-scroll" role="region" tabindex="0" aria-label="Client secrets in {{ environmentLabel }}">
          <table class="govuk-table" data-testid="client-secrets-table">
            <caption class="govuk-table__caption govuk-visually-hidden">Client secrets in {{ environmentLabel }}</caption>
            <thead class="govuk-table__head">
              <tr class="govuk-table__row">
                <th class="govuk-table__header" scope="col">Secret</th>
                <th class="govuk-table__header" scope="col">Expires</th>
                <th class="govuk-table__header" scope="col">Status</th>
                <th class="govuk-table__header" scope="col">Actions</th>
              </tr>
            </thead>
            <tbody class="govuk-table__body">
              {% for secret in clientSecrets.rows %}
                <tr class="govuk-table__row" data-testid="client-secret-row">
                  <td class="govuk-table__cell">{{ secret.hint }}</td>
                  <td class="govuk-table__cell">{{ (secret.expiresAt | formatDate) if secret.expiresAt else "Never" }}</td>
                  <td class="govuk-table__cell">{{ govukTag({ text: secret.status.text, classes: secret.status.classes }) }}</td>
                  <td class="govuk-table__cell">
                    {% if secret.revokeUrl %}
                      <a class="govuk-link" href="{{ secret.revokeUrl }}" data-testid="revoke-secret">Revoke<span class="govuk-visually-hidden"> secret {{ secret.hint | lower }}</span></a>
                    {% endif %}
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}

      {% if federations.length > 0 %}
        <h2 class="govuk-heading-l" id="federated-credentials" tabindex="-1">Federated credentials</h2>
        <div class="app-table-scroll" role="region" tabindex="0" aria-label="Federated credentials in {{ environmentLabel }}">
          <table class="govuk-table" data-testid="federations-table">
            <caption class="govuk-table__caption govuk-visually-hidden">Federated credentials in {{ environmentLabel }}</caption>
            <thead class="govuk-table__head">
              <tr class="govuk-table__row">
                <th class="govuk-table__header" scope="col">Application</th>
                <th class="govuk-table__header" scope="col">Type</th>
                <th class="govuk-table__header" scope="col">Status</th>
              </tr>
            </thead>
            <tbody class="govuk-table__body">
              {% for federation in federations %}
                <tr class="govuk-table__row" data-testid="federation-row">
                  <td class="govuk-table__cell">{{ federation.name }}</td>
                  <td class="govuk-table__cell">{{ federation.kind }}</td>
                  <td class="govuk-table__cell">
                    {{ govukTag({ text: federation.status.text, classes: federation.status.classes }) }}
                    {% if federation.reason %}<p class="govuk-hint govuk-!-margin-top-1 govuk-!-margin-bottom-0">{{ federation.reason }}</p>{% endif %}
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        <p class="govuk-hint" data-testid="federations-note">Disable and Enable credentials change client secrets only. They do not change these.</p>
      {% endif %}

      <h2 class="govuk-heading-l" id="health" tabindex="-1">Deployment health</h2>

      {% if models.length == 0 %}
        <p class="govuk-body" data-testid="no-models">This team has no models in {{ environmentLabel }}.</p>
      {% else %}
        <div class="app-table-scroll" role="region" tabindex="0" aria-label="Deployment health in {{ environmentLabel }}">
        <table class="govuk-table" data-testid="health-table">
          <caption class="govuk-table__caption govuk-visually-hidden">Deployment health in {{ environmentLabel }}</caption>
          <thead class="govuk-table__head">
            <tr class="govuk-table__row">
              <th class="govuk-table__header" scope="col">Model</th>
              <th class="govuk-table__header" scope="col">Status</th>
              <th class="govuk-table__header" scope="col">Detail</th>
              <th class="govuk-table__header" scope="col">Updated</th>
              <th class="govuk-table__header" scope="col">Actions</th>
            </tr>
          </thead>
          <tbody class="govuk-table__body">
            {% for model in models %}
              <tr class="govuk-table__row" data-testid="model-row">
                <td class="govuk-table__cell">{{ model.name }}</td>
                <td class="govuk-table__cell">{{ govukTag({ text: model.status.text, classes: model.status.classes }) }}</td>
                <td class="govuk-table__cell">{{ model.detail }}</td>
                <td class="govuk-table__cell"><time datetime="{{ model.at }}">{{ model.updated }}</time></td>
                <td class="govuk-table__cell">
                  <form method="post" action="{{ model.reconcileUrl }}" novalidate>
                    <input type="hidden" name="crumb" value="{{ crumb }}">
                    <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-2" data-module="govuk-button" data-prevent-double-click="true">Reconcile<span class="govuk-visually-hidden"> {{ model.name }}</span></button>
                  </form>
                  {% if model.retryUrl %}
                    <form method="post" action="{{ model.retryUrl }}" novalidate>
                      <input type="hidden" name="crumb" value="{{ crumb }}">
                      <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-2" data-module="govuk-button" data-prevent-double-click="true">Retry<span class="govuk-visually-hidden"> {{ model.name }}</span></button>
                    </form>
                  {% endif %}
                  {% if model.needsNewRequest %}
                    <p class="govuk-hint govuk-!-margin-bottom-0">The team must request this model again.</p>
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
        </div>
      {% endif %}
    </div>
  </div>
{% endblock %}
