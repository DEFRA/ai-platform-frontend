{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "sub-navigation/macro.njk" import appSubNavigation %}

{% block content %}
  {% include "partials/team-notification.njk" %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errorSummary %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: errorSummary
        }) }}
      {% endif %}
    </div>
  </div>

  {{ appHeading({
    text: heading,
    caption: caption,
    captionAbove: true
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <p class="govuk-body">
        {{ govukTag({ text: status.text, classes: status.classes, attributes: { "data-testid": "deployment-status" } }) }}
      </p>

      {{ appSubNavigation({ items: tabs, label: "Admin" }) }}

      {% set credentialHtml %}
        {{ govukTag({ text: credential.text, classes: credential.classes }) }}
        {% if blockedAt %}
          <p class="govuk-body-s govuk-!-margin-top-1 govuk-!-margin-bottom-0">Disabled on {{ blockedAt }}</p>
        {% endif %}
        {% if underBlock %}
          <p class="govuk-body-s govuk-!-margin-top-1 govuk-!-margin-bottom-0" data-testid="credential-under-block">Credential under the block: {{ govukTag({ text: underBlock.text, classes: underBlock.classes }) }}</p>
        {% endif %}
      {% endset %}
      {% set membersHtml %}
        {{ memberText }}
        <a class="govuk-link govuk-!-margin-left-2" href="{{ teamUrl }}" data-testid="view-team">View team</a>
      {% endset %}
      {% set teamStatusHtml %}{{ govukTag({ text: team.statusTag.text, classes: team.statusTag.classes }) }}{% endset %}

      {{ govukSummaryList({
        attributes: { "data-testid": "deployment-summary" },
        rows: [
          { key: { text: "Credential" }, value: { html: credentialHtml } },
          { key: { text: "Members" }, value: { html: membersHtml } },
          { key: { text: "Team status" }, value: { html: teamStatusHtml } }
        ]
      }) }}

      {% if buttons.length > 0 %}
        <div class="govuk-button-group" data-testid="credential-actions">
          {% for button in buttons %}
            {{ govukButton({
              text: button.text,
              href: button.href,
              classes: button.classes,
              attributes: { "data-testid": button.action + "-credentials" }
            }) }}
          {% endfor %}
        </div>
      {% endif %}

      <p class="govuk-body">
        <a class="govuk-link" href="{{ activityUrl }}" data-testid="view-activity">View activity</a>
      </p>

      <h2 class="govuk-heading-l" id="health" tabindex="-1">Deployment health</h2>

      {% if models.length == 0 %}
        <p class="govuk-body" data-testid="no-models">This team has no models in {{ environmentLabel }}.</p>
      {% else %}
        <div class="app-table-scroll" role="region" tabindex="0" aria-label="Deployment health in {{ environmentLabel }}">
        <table class="govuk-table" data-testid="health-table">
          <caption class="govuk-table__caption govuk-visually-hidden">Deployment health in {{ environmentLabel }}</caption>
          <thead class="govuk-table__head">
            <tr class="govuk-table__row">
              <th class="govuk-table__header" scope="col">Model</th>
              <th class="govuk-table__header" scope="col">Status</th>
              <th class="govuk-table__header" scope="col">Detail</th>
              <th class="govuk-table__header" scope="col">Updated</th>
              <th class="govuk-table__header" scope="col">Actions</th>
            </tr>
          </thead>
          <tbody class="govuk-table__body">
            {% for model in models %}
              <tr class="govuk-table__row" data-testid="model-row">
                <td class="govuk-table__cell">{{ model.name }}</td>
                <td class="govuk-table__cell">{{ govukTag({ text: model.status.text, classes: model.status.classes }) }}</td>
                <td class="govuk-table__cell">{{ model.detail }}</td>
                <td class="govuk-table__cell"><time datetime="{{ model.at }}">{{ model.updated }}</time></td>
                <td class="govuk-table__cell">
                  <form method="post" action="{{ model.reconcileUrl }}" novalidate>
                    <input type="hidden" name="crumb" value="{{ crumb }}">
                    <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-2" data-module="govuk-button" data-prevent-double-click="true">Reconcile<span class="govuk-visually-hidden"> {{ model.name }}</span></button>
                  </form>
                  {% if model.retryUrl %}
                    <form method="post" action="{{ model.retryUrl }}" novalidate>
                      <input type="hidden" name="crumb" value="{{ crumb }}">
                      <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-2" data-module="govuk-button" data-prevent-double-click="true">Retry<span class="govuk-visually-hidden"> {{ model.name }}</span></button>
                    </form>
                  {% endif %}
                  {% if model.needsNewRequest %}
                    <p class="govuk-hint govuk-!-margin-bottom-0">The team must request this model again.</p>
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
        </div>
      {% endif %}

      {% if environments.length > 0 %}
        <h2 class="govuk-heading-m">This team in each environment</h2>
        <ul class="govuk-list" data-testid="team-environments">
          {% for item in environments %}
            <li>
              {% if item.current %}
                {{ item.name }} (this page):
              {% else %}
                <a class="govuk-link" href="{{ item.href }}">{{ item.name }}</a>:
              {% endif %}
              {{ govukTag({ text: item.credential.text, classes: item.credential.classes }) }}
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </div>
{% endblock %}
