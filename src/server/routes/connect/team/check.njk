{% extends 'layouts/page.njk' %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% block beforeContent %}
  {{ super() }}
  {{ govukBackLink({ text: "Back", href: backLink }) }}
{% endblock %}

{% block content %}
  {{ appHeading({
    text: heading,
    caption: teamName,
    captionAbove: true
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errorMessage %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: [{ text: errorMessage }]
        }) }}
      {% endif %}

      {{ govukSummaryList({
        rows: [
          {
            key: { text: "Team" },
            value: { text: teamName },
            actions: { items: [{ href: teamChangeUrl, text: "Change", visuallyHiddenText: "team" }] }
          },
          {
            key: { text: "Models" if models.length > 1 else "Model" },
            value: { text: modelNames },
            actions: { items: [{ href: modelsChangeUrl, text: "Change", visuallyHiddenText: "models" }] }
          },
          {
            key: { text: "What it is for" },
            value: { text: purpose or "Not given" },
            actions: { items: [{ href: purposeChangeUrl, text: "Change", visuallyHiddenText: "what it is for" }] }
          },
          {
            key: { text: "Environment" },
            value: { text: environmentName }
          }
        ]
      }) }}

      <h2 class="govuk-heading-m">Now request access</h2>
      <p class="govuk-body">We will set up a deployment of {{ modelNames }} for your team. It usually takes about 2 minutes, and you can leave the page while it happens.</p>

      <form method="post" novalidate>
        <input type="hidden" name="crumb" value="{{ crumb }}">

        {{ govukButton({ text: "Request access" }) }}

        {% if existingRequestUrl %}
          <p class="govuk-body">
            <a class="govuk-link" href="{{ existingRequestUrl }}">View the existing request</a>
          </p>
        {% endif %}
      </form>
    </div>
  </div>
{% endblock %}
