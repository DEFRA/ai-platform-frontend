{% extends 'layouts/page.njk' %}

{% block content %}
  {{ appHeading({
    text: heading,
    caption: teamName,
    captionAbove: true
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <p class="govuk-body-l" data-testid="request-lead">{{ lead }}</p>

      {# Checked again by progress-refresh.js; without script, "Check progress" does it. #}
      <div aria-live="polite" data-progress-refresh="{{ statusUrl }}">
        {% include "connect/team/partials/status.njk" %}
      </div>

      <p class="govuk-body">
        <a class="govuk-link" href="{{ environmentUrl }}">Back to {{ environmentLabel }}</a>
      </p>
    </div>
  </div>
{% endblock %}
