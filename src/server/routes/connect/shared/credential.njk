{% extends 'layouts/page.njk' %}

{% from "govuk/components/panel/macro.njk" import govukPanel %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "code-examples/macro.njk" import appCodeExamples %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {{ govukPanel({
        titleText: "Your key is ready",
        text: model.displayName + ", in Sandbox"
      }) }}

      {{ govukWarningText({
        text: "This key is shown once. Copy it now and store it safely.",
        iconFallbackText: "Warning"
      }) }}

      <h2 class="govuk-heading-m">Your key</h2>
      <div class="app-copy-field">
        <input class="govuk-input app-copy-field__input" id="credential-key" type="text" value="{{ secret }}" readonly aria-label="Your key">
        <button type="button" class="govuk-button govuk-button--secondary app-copy-button" data-copy-target="credential-key" data-testid="copy-key-button" hidden>Copy key</button>
      </div>

      {{ govukSummaryList({
        rows: [
          {
            key: { text: "Endpoint" },
            value: { text: endpoint }
          },
          {
            key: { text: "Deployment name" },
            value: { text: model.deploymentName }
          },
          {
            key: { text: "API version" },
            value: { text: model.apiVersion }
          },
          {
            key: { text: "Rate limit" },
            value: { text: model.limitsDefault.requestsPerMinute ~ " requests a minute" }
          },
          {
            key: { text: "Runs out" },
            value: { text: credential.expiresAt | formatDate or "Does not expire" }
          }
        ]
      }) }}

      <h2 class="govuk-heading-m">Try it now</h2>
      {{ appCodeExamples({
        endpoint: endpoint,
        requestBody: requestBody,
        secretPlaceholder: secret
      }) }}
      {{ govukInsetText({
        text: "Your key is real and ready to use against the gateway above."
      }) }}

      <h2 class="govuk-heading-m">What next</h2>
      <ul class="govuk-list">
        <li><a class="govuk-link" href="/manage">See this key and your other access</a></li>
        <li><a class="govuk-link" href="#">Read the quick start guide</a></li>
        <li><a class="govuk-link" href="#">Tell us how that went</a></li>
      </ul>
    </div>
  </div>
{% endblock %}

