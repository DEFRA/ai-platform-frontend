{% extends 'layouts/page.njk' %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/character-count/macro.njk" import govukCharacterCount %}
{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% block beforeContent %}
  {{ super() }}
  {{ govukBackLink({ text: "Back", href: "/connect" }) }}
{% endblock %}

{% block content %}
  {{ appHeading({
    text: heading
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errorSummary %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: errorSummary
        }) }}
      {% endif %}

      <p class="govuk-body">
        A sentence is enough. We use this to understand what people are building, and to help you if a call is blocked.
      </p>

      <form method="post" novalidate>
        <input type="hidden" name="crumb" value="{{ crumb }}">

        {{ govukCharacterCount({
          id: "purpose",
          name: "purpose",
          maxlength: 500,
          value: values.purpose,
          label: {
            text: heading,
            classes: "govuk-visually-hidden"
          },
          errorMessage: fieldErrors.purpose
        }) }}

        <h3 class="govuk-heading-s">Before you continue</h3>
        <p class="govuk-body">A research key comes with limits:</p>
        <ul class="govuk-list govuk-list--bullet">
          <li>building and research only, not a live service</li>
          <li>no OFFICIAL-SENSITIVE data</li>
          <li>it stops working after 7 days</li>
          <li>you can renew it 3 times, then you need a team key</li>
        </ul>

        {{ govukCheckboxes({
          idPrefix: "agreeToTerms",
          name: "agreeToTerms",
          fieldset: {
            legend: {
              text: "Terms of use",
              classes: "govuk-visually-hidden"
            }
          },
          errorMessage: fieldErrors.agreeToTerms,
          items: [
            {
              value: "true",
              text: "I understand these limits"
            }
          ]
        }) }}

        {{ govukButton({ text: "Continue" }) }}
      </form>
    </div>
  </div>
{% endblock %}

