{% extends 'layouts/page.njk' %}

{% from "govuk/components/character-count/macro.njk" import govukCharacterCount %}
{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% block content %}
  {{ appHeading({
    text: heading
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errorSummary %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: errorSummary
        }) }}
      {% endif %}

      <form method="post" novalidate>
        <input type="hidden" name="crumb" value="{{ crumb }}">

        {{ govukCharacterCount({
          id: "purpose",
          name: "purpose",
          maxlength: 500,
          value: values.purpose,
          label: {
            text: "What will you use this model for?",
            classes: "govuk-label--m"
          },
          hint: { text: "For example, the project or piece of work this credential supports." },
          errorMessage: fieldErrors.purpose
        }) }}

        {{ govukCheckboxes({
          idPrefix: "agreeToTerms",
          name: "agreeToTerms",
          fieldset: {
            legend: {
              text: "Terms of use",
              classes: "govuk-fieldset__legend--m"
            }
          },
          errorMessage: fieldErrors.agreeToTerms,
          items: [
            {
              value: "true",
              text: "I agree to the acceptable use terms"
            }
          ]
        }) }}

        {{ govukButton({ text: "Continue" }) }}
      </form>
    </div>
  </div>
{% endblock %}
