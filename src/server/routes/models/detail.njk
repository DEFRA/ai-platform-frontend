{% extends 'layouts/page.njk' %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "code-examples/macro.njk" import appCodeExamples %}

{% block beforeContent %}
  {{ super() }}
  {{ govukBackLink({ text: "Back to models", href: "/models" }) }}
{% endblock %}

{% block content %}
  {{ appHeading({
    text: heading,
    caption: provider,
    captionAbove: true
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if goodFor %}
        <p class="govuk-body-l" data-testid="model-good-for">Good for {{ goodFor }}.</p>
      {% endif %}

      {% if canAddToTeam or canTry %}
        <div class="govuk-button-group">
          {% if canAddToTeam %}
            {{ govukButton({
              text: "Add to a team",
              href: addToTeamUrl,
              attributes: { "data-testid": "model-add-to-team" }
            }) }}
          {% endif %}
          {% if canTry %}
            <a class="govuk-link" href="{{ tryUrl }}" data-testid="model-try-on-your-own">Try it on your own</a>
          {% endif %}
        </div>
      {% elif not eligible %}
        <p class="govuk-body" data-testid="model-not-available">Not available yet. {{ statusReason }}</p>
      {% endif %}

      <h2 class="govuk-heading-m">How you can use it</h2>
      {{ govukSummaryList({ rows: useRows, attributes: { "data-testid": "model-use-rows" } }) }}
    </div>
  </div>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <h2 class="govuk-heading-m">Call it from your code</h2>
      {{ appCodeExamples({
        endpoint: endpoint,
        requestBody: requestBody,
        secretPlaceholder: "<YOUR_SUBSCRIPTION_KEY>"
      }) }}
      <p class="govuk-body govuk-hint" data-testid="model-needs-secret">You need a client secret or a key before this will work.</p>
    </div>
  </div>
{% endblock %}
