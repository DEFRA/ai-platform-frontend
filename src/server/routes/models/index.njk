{% extends 'layouts/page.njk' %}

{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "model-table/macro.njk" import appModelTable %}

{% block content %}
  {{ appHeading({
    text: heading
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <p class="govuk-body-l">Add a model to your team, or try one on your own first.</p>

      <div class="govuk-button-group">
        {{ govukButton({
          text: "Add models to a team",
          href: "/connect/team/start",
          attributes: { "data-testid": "models-add-to-team" }
        }) }}
        <a class="govuk-link" href="/connect/shared/start" data-testid="models-try-on-your-own">Try a model on your own for {{ researchDays }} days</a>
      </div>

      <form method="get" novalidate>
        <div class="app-filter-row">
          {{ govukSelect({
            id: "show",
            name: "show",
            label: { text: "Show", classes: "govuk-label--s" },
            items: showItems
          }) }}
          {{ govukButton({ text: "Apply", classes: "govuk-button--secondary" }) }}
          <a class="govuk-link" href="/models" data-testid="models-clear-filters">Clear</a>
        </div>
      </form>

      {{ appModelTable({ models: models }) }}

      {% if notAvailableRows.length > 0 %}
        <h2 class="govuk-heading-l" data-testid="models-not-available-heading">Not available yet</h2>
        {{ govukSummaryList({ rows: notAvailableRows, attributes: { "data-testid": "models-not-available" } }) }}
      {% endif %}
    </div>
  </div>
{% endblock %}
