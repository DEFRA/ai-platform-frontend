{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "members-table/macro.njk" import appMembersTable %}
{% from "sub-navigation/macro.njk" import appSubNavigation %}

{% block content %}
  {% include "partials/team-notification.njk" %}

  {{ appHeading({
    text: heading,
    caption: "Team",
    captionAbove: true
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      {{ appSubNavigation({ items: tabs, label: "Team" }) }}

      {% if isAdmin %}
        {{ govukButton({
          text: "Add a member",
          href: addMemberUrl,
          attributes: { "data-testid": "add-member" }
        }) }}
      {% endif %}

      {{ appMembersTable({
        caption: "Members of " + team.name,
        rows: members,
        actionHeading: "Change" if isAdmin,
        actionTestId: "member-change"
      }) }}

      <p class="govuk-body govuk-hint">Members can use the team’s models and add new ones. Admins can also see and rotate client secrets, add people, change roles and remove models.</p>
    </div>
  </div>
{% endblock %}
