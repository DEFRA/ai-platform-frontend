{% extends 'layouts/page.njk' %}

{% from "govuk/components/panel/macro.njk" import govukPanel %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "placeholder-credential-notice/macro.njk" import appPlaceholderCredentialNotice %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {{ govukPanel({
        titleText: "Client secret rotated",
        text: "The old secret for " + modelNamesText + " no longer works"
      }) }}

      {{ govukWarningText({
        text: "This is the only time the new secret will be shown. Copy it now and store it securely.",
        iconFallbackText: "Warning"
      }) }}

      {% if placeholderCredential %}
        {{ appPlaceholderCredentialNotice() }}
      {% endif %}

      {{ govukSummaryList({
        rows: [
          {
            key: { text: "Client secret" },
            value: { text: secret }
          },
          {
            key: { text: "Runs out" },
            value: { text: credential.expiresAt | formatDate or "Does not expire" }
          }
        ]
      }) }}

      <p class="govuk-body">
        <a class="govuk-link" href="{{ teamUrl }}">Back to the team</a>
      </p>
    </div>
  </div>
{% endblock %}
