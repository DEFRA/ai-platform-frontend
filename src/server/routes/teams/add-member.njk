{% extends 'layouts/page.njk' %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "add-member-form/macro.njk" import appAddMemberForm %}

{% block beforeContent %}
  {{ super() }}
  {{ govukBackLink({ text: "Back", href: backUrl }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errorSummary %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: errorSummary
        }) }}
      {% endif %}
    </div>
  </div>

  {{ appHeading({
    text: heading,
    caption: team.name,
    captionAbove: true
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {{ appAddMemberForm({
        searchUrl: searchUrl,
        crumb: crumb,
        idempotencyKey: idempotencyKey,
        values: values,
        fieldErrors: fieldErrors,
        personItems: personItems,
        personCount: personCount,
        noMatches: noMatches
      }) }}
    </div>
  </div>
{% endblock %}

{% block bodyEnd %}
  {{ super() }}
  <script type="module" src="{{ getAssetPath('src/client/javascripts/people-search-entry.js') }}"></script>
{% endblock %}
