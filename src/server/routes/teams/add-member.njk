{% extends 'layouts/page.njk' %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "role-radios/macro.njk" import appRoleRadios %}

{% block beforeContent %}
  {{ super() }}
  {{ govukBackLink({ text: "Back", href: backUrl }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errorSummary %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: errorSummary
        }) }}
      {% endif %}
    </div>
  </div>

  {{ appHeading({
    text: heading,
    caption: team.name,
    captionAbove: true
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {# Without script, Search posts the text and this page comes back with the
         matches in a select list. With script, people-search.js turns the text
         field into a combobox and sends the person chosen in a hidden `oid`. #}
      <form method="post" novalidate data-people-search-url="{{ searchUrl }}">
        <input type="hidden" name="crumb" value="{{ crumb }}">
        {# The key of this add: sent again with a retry, so the backend adds once. #}
        <input type="hidden" name="idempotencyKey" value="{{ idempotencyKey }}">

        {{ govukInput({
          id: "search",
          name: "search",
          value: values.search,
          autocomplete: "off",
          spellcheck: false,
          classes: "govuk-!-width-full",
          label: {
            text: "Name or email address",
            classes: "govuk-label--m"
          },
          hint: { text: "Enter at least 2 characters of their name or Defra email address" },
          errorMessage: fieldErrors.search,
          attributes: { "data-people-search": "", "data-people-query": values.query or "" }
        }) }}

        {{ govukButton({
          text: "Search",
          name: "action",
          value: "search",
          classes: "govuk-button--secondary",
          preventDoubleClick: true,
          attributes: { "data-testid": "search-people", "data-people-search-button": "" }
        }) }}

        {% if personItems %}
          {{ govukSelect({
            id: "oid",
            name: "oid",
            classes: "govuk-!-width-full",
            label: {
              text: "Person",
              classes: "govuk-label--m"
            },
            hint: { text: personCount + (" person" if personCount == 1 else " people") + " found" },
            items: personItems,
            errorMessage: fieldErrors.oid
          }) }}
        {% elif noMatches %}
          <div data-testid="no-people">
            <h2 class="govuk-heading-m">No people found</h2>
            <p class="govuk-body">No one found for ‘{{ values.search }}’. Try their full email address.</p>
          </div>
        {% endif %}

        {{ appRoleRadios({ value: values.role, errorMessage: fieldErrors.role }) }}

        {{ govukInsetText({ text: "They can use the team straight away" }) }}

        {{ govukButton({
          text: "Add",
          name: "action",
          value: "add",
          attributes: { "data-testid": "add-member-submit" }
        }) }}
      </form>
    </div>
  </div>
{% endblock %}

{% block bodyEnd %}
  {{ super() }}
  <script type="module" src="{{ getAssetPath('src/client/javascripts/people-search-entry.js') }}"></script>
{% endblock %}
