{% extends 'layouts/page.njk' %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}

{% block beforeContent %}
  {{ super() }}
  {{ govukBackLink({ text: "Back", href: backUrl }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errorSummary %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: errorSummary
        }) }}
      {% endif %}
    </div>
  </div>

  {{ appHeading({
    text: heading,
    caption: team.name,
    captionAbove: true
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <div id="remove-member">
        {{ govukWarningText({
          text: "Removing someone does not change the client secret. Rotate it if they had a copy.",
          iconFallbackText: "Warning"
        }) }}
      </div>

      <form method="post" novalidate>
        <input type="hidden" name="crumb" value="{{ crumb }}">

        <div class="govuk-button-group">
          {{ govukButton({
            text: buttonText,
            classes: "govuk-button--warning",
            attributes: { "data-testid": "remove-member-confirm" }
          }) }}
          <a class="govuk-link" href="{{ cancelUrl }}" data-testid="remove-member-cancel">Cancel</a>
        </div>
      </form>
    </div>
  </div>
{% endblock %}
