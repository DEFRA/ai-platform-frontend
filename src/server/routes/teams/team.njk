{% extends 'layouts/page.njk' %}

{% from "sub-navigation/macro.njk" import appSubNavigation %}
{% from "section-card/macro.njk" import appSectionCard %}

{% block content %}
  {% include "partials/team-notification.njk" %}

  {{ appHeading({
    text: heading,
    caption: "Team",
    captionAbove: true
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      {{ appSubNavigation({ items: tabs, label: "Team" }) }}

      {% call appSectionCard({ title: "Models your team uses", attributes: { "data-testid": "section-team-models" } }) %}
      {% if unavailable %}
        <p class="govuk-body" data-testid="overview-unavailable">We could not read this team’s environments just now. <a class="govuk-link" href="{{ teamUrl }}">Try again</a>.</p>
      {% elif models.length %}
        <ul class="govuk-list govuk-list--bullet" data-testid="team-models">
          {% for model in models %}
            <li>{{ model.name }}{% if model.suffix %}{% if model.failed %}<strong>, {{ model.suffix }}</strong>{% else %}, {{ model.suffix }}{% endif %}{% endif %}</li>
          {% endfor %}
        </ul>
      {% else %}
        <p class="govuk-body" data-testid="team-models-none">No models yet.</p>
      {% endif %}
      {% endcall %}

      {% call appSectionCard({ title: "Environments and deployments", attributes: { "data-testid": "section-team-environments" } }) %}
      {% if not unavailable %}
        <dl class="govuk-summary-list app-summary-list--table">
          {% for environment in environments %}
            <div class="govuk-summary-list__row govuk-summary-list__row--no-actions" data-testid="overview-environment">
              <dt class="govuk-summary-list__key">{{ environment.name }} <span class="govuk-!-font-weight-regular">{{ environment.displayName }}</span></dt>
              <dd class="govuk-summary-list__value">{{ environment.text }}</dd>
            </div>
          {% endfor %}
        </dl>
      {% endif %}
      <p class="govuk-body govuk-!-margin-top-4">
        <a class="govuk-link" href="{{ environmentsUrl }}" data-testid="view-environments">View environments and deployments</a>
      </p>
      {% endcall %}
    </div>
  </div>
{% endblock %}
