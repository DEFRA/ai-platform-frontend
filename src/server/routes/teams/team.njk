{% extends 'layouts/page.njk' %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}

{% block beforeContent %}
  {{ super() }}
  {{ govukBackLink({ text: "Back to your access", href: "/manage" }) }}
{% endblock %}

{% block content %}
  {{ appHeading({
    text: heading
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if notification %}
        {{ govukNotificationBanner({
          text: notification.message,
          type: "success" if notification.type == "success" else ""
        }) }}
      {% endif %}

      {% if errorSummary %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: errorSummary
        }) }}
      {% endif %}

      {% set serviceCodeHtml %}
        {{ team.serviceCode or "Not given" }}
        {% if not team.verified %}
          {{ govukTag({ text: "To be verified", classes: "govuk-tag--yellow" }) }}
        {% endif %}
      {% endset %}

      {% set teamIdHtml %}
        {{ team.slug }}
        <p class="govuk-hint govuk-!-margin-bottom-0">Used in your team's address on the AI gateway. It is set from the team name and cannot be changed.</p>
      {% endset %}

      {{ govukSummaryList({
        rows: [
          {
            key: { text: "Team ID" },
            value: { html: teamIdHtml }
          },
          {
            key: { text: "Service code" },
            value: { html: serviceCodeHtml }
          },
          {
            key: { text: "What the team does" },
            value: { text: team.description or "Not given" }
          },
          {
            key: { text: "Your role" },
            value: { text: "Admin" if isAdmin else "Member" }
          }
        ]
      }) }}

      <h2 class="govuk-heading-m">Models</h2>

      {% if modelsUnavailable %}
        <p class="govuk-body" data-testid="team-models-unavailable">We could not list this team’s models just now. <a class="govuk-link" href="/teams/{{ team._id }}">Try again</a>.</p>
      {% elif models.length %}
        {% if modelsChanging %}
          <p class="govuk-body" data-testid="team-models-changing">A model is changing. <a class="govuk-link" href="/teams/{{ team._id }}">Refresh this page</a> to see the latest status.</p>
        {% endif %}
        <table class="govuk-table" data-testid="team-models">
          <thead class="govuk-table__head">
            <tr class="govuk-table__row">
              <th class="govuk-table__header" scope="col">Model</th>
              <th class="govuk-table__header" scope="col">Environment</th>
              <th class="govuk-table__header" scope="col">Status</th>
              <th class="govuk-table__header" scope="col">Actions</th>
            </tr>
          </thead>
          <tbody class="govuk-table__body">
            {% for model in models %}
              <tr class="govuk-table__row">
                <td class="govuk-table__cell">{{ model.modelDisplayName }}</td>
                <td class="govuk-table__cell">{{ model.environment }}</td>
                <td class="govuk-table__cell">
                  {{ govukTag({ text: model.statusText, classes: model.tagClass }) }}
                  {% if model.failureReason %}
                    <p class="govuk-hint govuk-!-margin-bottom-0">{{ model.failureReason }}</p>
                  {% endif %}
                </td>
                <td class="govuk-table__cell">
                  {% if model.canRemove %}
                    <a class="govuk-link" href="{{ model.removeUrl }}" data-testid="model-remove">Remove<span class="govuk-visually-hidden"> {{ model.modelDisplayName }}</span></a>
                  {% elif model.status != "removed" and model.status != "active" %}
                    <a class="govuk-link" href="{{ model.requestUrl }}">Check progress<span class="govuk-visually-hidden"> of {{ model.modelDisplayName }}</span></a>
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      {% else %}
        <p class="govuk-body">This team has no models yet. <a class="govuk-link" href="/connect">Connect to a model</a> to add one.</p>
      {% endif %}

      <h2 class="govuk-heading-m">Members</h2>

      <table class="govuk-table">
        <thead class="govuk-table__head">
          <tr class="govuk-table__row">
            <th class="govuk-table__header" scope="col">Name</th>
            <th class="govuk-table__header" scope="col">Email</th>
            <th class="govuk-table__header" scope="col">Role</th>
            <th class="govuk-table__header" scope="col">Status</th>
            <th class="govuk-table__header" scope="col">Actions</th>
          </tr>
        </thead>
        <tbody class="govuk-table__body">
          {% for member in members %}
            <tr class="govuk-table__row">
              <td class="govuk-table__cell">{{ member.displayName or "Not signed in yet" }}</td>
              <td class="govuk-table__cell">{{ member.email or "Team creator" }}</td>
              <td class="govuk-table__cell">{{ "Admin" if member.role == "admin" else "Member" }}</td>
              <td class="govuk-table__cell">
                {{ govukTag({
                  text: "Active" if member.status == "active" else "Invited",
                  classes: "govuk-tag--green" if member.status == "active" else "govuk-tag--blue"
                }) }}
              </td>
              <td class="govuk-table__cell">
                {% if member.canChangeRole %}
                  <form method="post" action="/teams/{{ team._id }}/members/{{ member._id }}/role" novalidate>
                    <input type="hidden" name="crumb" value="{{ crumb }}">
                    <input type="hidden" name="role" value="{{ member.nextRole }}">
                    <button type="submit" class="govuk-link app-link-button" data-testid="member-role">
                      {{ "Make a member" if member.role == "admin" else "Make an admin" }}
                    </button>
                  </form>
                {% endif %}
                {% if member.canRemove %}
                  <form method="post" action="/teams/{{ team._id }}/members/{{ member._id }}/remove" novalidate>
                    <input type="hidden" name="crumb" value="{{ crumb }}">
                    <button type="submit" class="govuk-link app-link-button" data-testid="member-remove">Remove</button>
                  </form>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>

      {% if isAdmin %}
        <h2 class="govuk-heading-m">Change the service code</h2>

        <form method="post" action="/teams/{{ team._id }}/service-code" novalidate>
          <input type="hidden" name="crumb" value="{{ crumb }}">

          {{ govukInput({
            id: "serviceCode",
            name: "serviceCode",
            value: serviceCodeValue,
            classes: "govuk-input--width-3",
            label: { text: "Service code" },
            hint: { text: "Three letters or numbers. Your team's AI use is charged to this service." },
            errorMessage: fieldErrors.serviceCode
          }) }}

          {{ govukButton({ text: "Save service code", classes: "govuk-button--secondary" }) }}
        </form>

        <h2 class="govuk-heading-m">Add a member</h2>

        <form method="post" action="/teams/{{ team._id }}/members" novalidate>
          <input type="hidden" name="crumb" value="{{ crumb }}">

          {{ govukInput({
            id: "email",
            name: "email",
            type: "email",
            label: { text: "Email address" },
            errorMessage: fieldErrors.email
          }) }}

          {{ govukButton({ text: "Add member" }) }}
        </form>

        {{ govukWarningText({
          text: "Removing someone does not change the team client secret. Rotate it if they had a copy.",
          iconFallbackText: "Warning"
        }) }}
      {% endif %}
    </div>
  </div>
{% endblock %}

