{% extends 'layouts/page.njk' %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "role-radios/macro.njk" import appRoleRadios %}

{% block beforeContent %}
  {{ super() }}
  {{ govukBackLink({ text: "Back", href: backUrl }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errorSummary %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: errorSummary
        }) }}
      {% endif %}
    </div>
  </div>

  {{ appHeading({
    text: heading,
    caption: team.name,
    captionAbove: true
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <form method="post" novalidate>
        <input type="hidden" name="crumb" value="{{ crumb }}">

        {{ appRoleRadios({ value: role, errorMessage: fieldErrors.role }) }}

        {{ govukButton({
          text: "Save role",
          attributes: { "data-testid": "save-role" }
        }) }}
      </form>

      <p class="govuk-body">
        <a class="govuk-link" href="{{ removeUrl }}" data-testid="remove-member-link">{{ removeText }}</a>
      </p>
    </div>
  </div>
{% endblock %}
