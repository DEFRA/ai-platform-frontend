{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/select/macro.njk" import govukSelect %}

{% block content %}
  {% include "partials/team-notification.njk" %}

  {{ appHeading({
    text: heading,
    caption: team.name,
    captionAbove: true
  }) }}

  {# With script, choosing a team switches to it (team-switcher.js); the button is for browsers without it. #}
  {% if teamSwitcher %}
    <form class="app-filter-row" method="get" action="{{ teamSwitcher.action }}" data-team-switcher data-testid="team-switcher">
      {{ govukSelect({
        id: "team",
        name: "team",
        label: { text: "Team", classes: "govuk-label--s" },
        items: teamSwitcher.items
      }) }}
      <noscript>
        {{ govukButton({
          text: "Switch team",
          classes: "govuk-button--secondary",
          attributes: { "data-testid": "switch-team" }
        }) }}
      </noscript>
    </form>
  {% endif %}

  <p class="govuk-body-l">Where {{ team.name }}’s models are deployed, and what is changing now.</p>

  <div class="app-actions--end" data-testid="page-actions">
    {% if federateUrl %}
      {{ govukButton({
        text: "Create Passwordless Credential",
        href: federateUrl,
        classes: "govuk-!-margin-bottom-0",
        attributes: { "data-testid": "federate-an-application" }
      }) }}
    {% endif %}
    {{ govukButton({
      text: "Deploy a model",
      href: deployUrl,
      classes: "govuk-!-margin-bottom-0",
      attributes: { "data-testid": "deploy-a-model" }
    }) }}
  </div>

  {# Checked again by progress-refresh.js while a change is open; without script, "Check progress" does it. #}
  <div aria-live="polite" data-progress-refresh="{{ statusUrl }}">
    {% include "environments/partials/overview-status.njk" %}
  </div>
{% endblock %}
