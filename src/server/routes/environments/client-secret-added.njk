{% extends 'layouts/page.njk' %}

{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "copy-value/macro.njk" import appCopyValue %}
{% from "placeholder-credential-notice/macro.njk" import appPlaceholderCredentialNotice %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {{ appHeading({
        text: heading,
        caption: caption,
        captionAbove: true
      }) }}

      {{ govukWarningText({
        text: "This client secret is shown once. Copy it now and store it safely.",
        iconFallbackText: "Warning"
      }) }}

      {% if placeholderCredential %}
        {{ appPlaceholderCredentialNotice() }}
      {% endif %}

      {% set secretHtml %}{{ appCopyValue({ id: "client-secret-value", value: secret, label: "client secret" }) }}{% endset %}
      {% set rows = [{ key: { text: "Client secret" }, value: { html: secretHtml } }] %}
      {% if name %}
        {% set _ = rows.push({ key: { text: "Name" }, value: { text: name } }) %}
      {% endif %}
      {% set _ = rows.push(
        { key: { text: "Environment" }, value: { text: environmentName } },
        { key: { text: "Stops working" }, value: { text: expiresText } }
      ) %}
      {{ govukSummaryList({
        attributes: { "data-testid": "client-secret-added" },
        rows: rows
      }) }}

      <h2 class="govuk-heading-m">What to do next</h2>
      <ol class="govuk-list govuk-list--number" data-testid="client-secret-next-steps">
        <li>Store it in a secret store or an environment variable on your machine. Never put it in your code or commit it.</li>
        <li>Use it to <a class="govuk-link" href="{{ guidanceHref }}">get a token with a client secret</a>, then call the gateway with the token.</li>
        {% if expires %}
          <li>It stops working on {{ expiresText }}. Before then, rotate it or add a new one.</li>
        {% endif %}
        <li>Keep it for local development. Your deployed applications should use a <a class="govuk-link" href="{{ applicationsHref }}">passwordless credential</a>.</li>
      </ol>

      <p class="govuk-body">
        <a class="govuk-link" href="{{ returnHref }}">{{ returnText }}</a>
      </p>
    </div>
  </div>
{% endblock %}
