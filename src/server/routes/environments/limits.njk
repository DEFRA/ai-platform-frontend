{% extends 'layouts/page.njk' %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% block beforeContent %}
  {{ super() }}
  {{ govukBackLink({ text: "Back", href: backLink }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errorSummary %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: errorSummary
        }) }}
      {% endif %}

      <span class="govuk-caption-xl" data-testid="app-heading-caption">{{ teamName }}</span>
      <h1 class="govuk-heading-xl">{{ heading }}</h1>

      <p class="govuk-body">A change within the platform’s bounds applies in a few minutes. For more, ask the AI Platform team.</p>

      <form method="post" novalidate>
        <input type="hidden" name="crumb" value="{{ crumb }}">

        {{ govukInput({
          id: "tokensPerMinute",
          name: "tokensPerMinute",
          label: { text: "Tokens a minute", classes: "govuk-label--m" },
          hint: { text: hints.tokensPerMinute },
          classes: "govuk-input--width-10",
          inputmode: "numeric",
          spellcheck: false,
          value: values.tokensPerMinute,
          errorMessage: fieldErrors.tokensPerMinute
        }) }}

        {{ govukInput({
          id: "requestsPerMinute",
          name: "requestsPerMinute",
          label: { text: "Requests a minute", classes: "govuk-label--m" },
          hint: { text: hints.requestsPerMinute },
          classes: "govuk-input--width-10",
          inputmode: "numeric",
          spellcheck: false,
          value: values.requestsPerMinute,
          errorMessage: fieldErrors.requestsPerMinute
        }) }}

        {{ govukButton({ text: "Continue" }) }}
      </form>
    </div>
  </div>
{% endblock %}
