{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}

{% block content %}
  {{ appHeading({
    text: heading
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <p class="govuk-body" data-testid="teams-empty">You are not a member of a team yet. Create a team to set up its environments.</p>
      {{ govukButton({
        text: "Create a team",
        href: "/teams/new"
      }) }}
    </div>
  </div>
{% endblock %}
