{#
  Where each environment has got to in federating an application: its steps,
  or why it failed, and the way to check again. Shown by the page and, on its
  own, by `?fragment=status`; the page wraps it in the polite live region the
  script swaps it into. `data-in-progress` is read by the script: when it is
  "false" the script stops. Without script, "Check progress" loads the page
  again; once nothing is in progress it reads "See the result".
#}
{% from "step-list/macro.njk" import appStepList %}
{% from "environments/partials/failure.njk" import failureDetail %}

<div data-in-progress="{{ 'true' if inProgress else 'false' }}" data-testid="federate-status">
  {% for environment in environments %}
    <div class="govuk-!-margin-bottom-6" data-testid="federate-environment">
      <h2 class="govuk-heading-m govuk-!-margin-bottom-2">{{ environment.name }}</h2>
      {{ appStepList({ items: environment.steps }) }}
      {{ failureDetail(environment.failure) }}
    </div>
  {% endfor %}

  <p class="govuk-body">
    <a class="govuk-link" href="{{ pageUrl }}" data-testid="check-progress">{{ 'Check progress' if inProgress else 'See the result' }}</a>
  </p>
</div>
