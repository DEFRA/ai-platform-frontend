{% extends 'layouts/page.njk' %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/input/macro.njk" import govukInput %}

{% block beforeContent %}
  {{ super() }}
  {{ govukBackLink({ text: "Back", href: backLink }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errorSummary %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: errorSummary
        }) }}
      {% endif %}

      {{ appHeading({
        text: heading,
        caption: caption,
        captionAbove: true
      }) }}

      <p class="govuk-body">Use a client secret to get a token while you develop on your own machine. Your deployed applications should use a passwordless credential instead.</p>

      <h2 class="govuk-heading-m">What happens when you add one</h2>
      <ul class="govuk-list govuk-list--bullet" data-testid="client-secret-add-facts">
        <li>It stops working after at most three months.</li>
        <li>It is shown once, on the next page. Copy it then and keep it somewhere safe.</li>
        <li>You can view it again later. Each time is recorded.</li>
        <li>{{ countText }} in {{ environmentName }}. Adding one uses another place.</li>
      </ul>

      <form method="post" action="{{ formAction }}" novalidate>
        <input type="hidden" name="crumb" value="{{ crumb }}">
        <input type="hidden" name="key" value="{{ key }}">

        {{ govukInput({
          id: "name",
          name: "name",
          label: { text: "Name (optional)", classes: "govuk-label--s" },
          hint: { text: "A short name so you can tell your secrets apart, for example local-dev. Up to 30 characters: letters, numbers, spaces, hyphens, underscores and full stops." },
          classes: "govuk-!-width-one-half",
          spellcheck: false,
          autocomplete: "off",
          value: name,
          errorMessage: nameError
        }) }}

        <div class="govuk-button-group">
          {{ govukButton({
            text: "Add a client secret",
            preventDoubleClick: true,
            attributes: { id: "add-client-secret", "data-testid": "confirm-add-client-secret" }
          }) }}
          <a class="govuk-link" href="{{ cancelUrl }}">Cancel</a>
        </div>
      </form>
    </div>
  </div>
{% endblock %}
