{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}

{% block content %}
  {{ appHeading({
    text: heading
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      {% if signedIn %}
        <p class="govuk-body-l">Use approved AI models in your Defra service.</p>

        <div class="govuk-button-group">
          {{ govukButton({
            text: "Add models to a team",
            href: "/connect/team/start",
            attributes: { "data-testid": "home-add-to-team" }
          }) }}
          <a class="govuk-link" href="/connect/shared/start" data-testid="home-try-on-your-own">Try a model on your own</a>
        </div>

        {% if attention.length %}
          <h2 class="govuk-heading-m">Needs your attention</h2>
          <ul class="govuk-list govuk-list--bullet" data-testid="home-attention">
            {% for item in attention %}
              <li>{{ item.text }} <a class="govuk-link" href="{{ item.href }}">{{ item.linkText }}</a></li>
            {% endfor %}
          </ul>
        {% endif %}

        {% if usage and (usage.cards.length or usage.rows.length or usage.unavailable.length) %}
          <h2 class="govuk-heading-m" data-testid="home-usage-heading">Usage{% if usage.monthName %} in {{ usage.monthName }}{% endif %}</h2>
          {% if usage.isMock %}
            <p class="govuk-body" data-testid="home-usage-example">These figures are examples, not real use.</p>
          {% endif %}
          {% if usage.cards.length %}
            {% set cards = usage.cards %}
            {% include "usage/partials/cards.njk" %}
            <p class="govuk-body"><a class="govuk-link" href="{{ usage.href }}" data-testid="home-usage-link">View usage for {{ usage.teamName }}</a></p>
          {% endif %}
          {% if usage.rows.length %}
            <table class="govuk-table" data-testid="home-usage-table">
              <caption class="govuk-table__caption govuk-visually-hidden">Usage this month by team</caption>
              <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                  <th class="govuk-table__header" scope="col">Team</th>
                  <th class="govuk-table__header govuk-table__header--numeric" scope="col">Tokens</th>
                  <th class="govuk-table__header govuk-table__header--numeric" scope="col">Estimated cost</th>
                  <th class="govuk-table__header govuk-table__header--numeric" scope="col">Forecast</th>
                </tr>
              </thead>
              <tbody class="govuk-table__body">
                {% for row in usage.rows %}
                  <tr class="govuk-table__row">
                    <td class="govuk-table__cell"><a class="govuk-link" href="{{ row.href }}">{{ row.name }}</a></td>
                    <td class="govuk-table__cell govuk-table__cell--numeric">{{ row.tokens }}</td>
                    <td class="govuk-table__cell govuk-table__cell--numeric">{{ row.cost }}</td>
                    <td class="govuk-table__cell govuk-table__cell--numeric">{{ row.forecast }}</td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          {% endif %}
          {% if usage.unavailable.length %}
            <p class="govuk-body" data-testid="home-usage-unavailable">We could not check usage for {{ usage.unavailable | join(', ') }} just now.</p>
          {% endif %}
        {% endif %}

        <h2 class="govuk-heading-m" id="your-teams">Your teams</h2>
        {% if teams === null %}
          <p class="govuk-body" data-testid="home-teams-unavailable">We could not check your teams just now.</p>
        {% elif teams.length == 0 %}
          <p class="govuk-body" data-testid="home-teams-empty">You are not a member of a team yet.</p>
        {% else %}
          <table class="govuk-table" data-testid="home-teams">
            <caption class="govuk-table__caption govuk-visually-hidden">Your teams</caption>
            <thead class="govuk-table__head govuk-visually-hidden">
              <tr class="govuk-table__row">
                <th class="govuk-table__header" scope="col">Team</th>
                <th class="govuk-table__header govuk-table__header--numeric" scope="col">Your role and its models</th>
              </tr>
            </thead>
            <tbody class="govuk-table__body">
              {% for team in teams %}
                <tr class="govuk-table__row" data-testid="home-team">
                  <td class="govuk-table__cell"><a class="govuk-link" href="{{ team.href }}">{{ team.name }}</a></td>
                  <td class="govuk-table__cell govuk-table__cell--numeric">{{ team.summary }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
          {% set tablePage = teamsPage %}
          {% set tableNoun = "teams" %}
          {% include "partials/table-pagination.njk" %}
        {% endif %}

        <h2 class="govuk-heading-m">Your own keys</h2>
        {% if keys === null %}
          <p class="govuk-body" data-testid="home-keys-unavailable">We could not check your keys just now.</p>
        {% else %}
          <p class="govuk-body" data-testid="home-keys">
            {{ keys.text }}
            {% if keys.hasKeys %}
              <a class="govuk-link" href="/manage">Go to Personal access</a>
            {% endif %}
          </p>
        {% endif %}
      {% else %}
        <p class="govuk-body-l">Use approved AI models in your Defra service. You do not need a cloud account.</p>

        {{ govukButton({
          text: "Start now",
          href: "/sign-in?returnTo=%2Fmodels",
          isStartButton: true
        }) }}

        <h2 class="govuk-heading-m">Who it is for</h2>
        <p class="govuk-body">
          Anyone at Defra building a service or trying an idea out. Sign in with your Defra account.
        </p>

        <h2 class="govuk-heading-m">Two ways to get access</h2>

        <h3 class="govuk-heading-s">For your team’s service</h3>
        <p class="govuk-body">
          Your team gets its own deployment of a model in the UK or EU, set up in Development first. Everyone in the team uses it through one client secret.
        </p>

        <h3 class="govuk-heading-s">To try a model on your own</h3>
        <p class="govuk-body">
          A personal key that works for {{ researchDays }} days, with 60 requests a minute and 100,000 tokens a day. Do not put OFFICIAL-SENSITIVE data through it.
        </p>

        <h2 class="govuk-heading-m">Browse without signing in</h2>
        <p class="govuk-body">
          <a class="govuk-link" href="/models">See the models you can use</a>
        </p>
      {% endif %}
    </div>
  </div>
{% endblock %}
