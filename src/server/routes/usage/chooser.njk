{% extends 'layouts/page.njk' %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">{{ heading }}</h1>
      {% if teams.length %}
        <p class="govuk-body">Choose a team to see what it has used.</p>
        <ul class="govuk-list" data-testid="usage-teams">
          {% for team in teams %}<li><a class="govuk-link" href="{{ team.href }}">{{ team.name }}</a></li>{% endfor %}
        </ul>
      {% else %}
        <p class="govuk-body" data-testid="usage-no-teams">You are not a member of a team yet, so there is no team usage to show. Your own keys are under <a class="govuk-link" href="/manage">Personal access</a>.</p>
      {% endif %}
    </div>
  </div>
{% endblock %}
